## Ejemplo de configuración para Laragon (MySQL por defecto)
# Usuario por defecto: root
# Si no tienes contraseña en Laragon, omite la parte de la contraseña como en el ejemplo.
# Si tienes contraseña, reemplaza `yourPassword` y URL-encódala si contiene caracteres especiales.
DATABASE_URL="mysql://root@127.0.0.1:3306/inventory_db"
# Alternativa con contraseña:
# DATABASE_URL="mysql://root:yourPassword@127.0.0.1:3306/inventory_db"

PORT=3000

# Nota: copia este archivo a `.env` antes de ejecutar migraciones/seed.
